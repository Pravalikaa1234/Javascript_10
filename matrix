let A = [
    [1, 2],
    [3, 4]
];

let B = [
    [5, 6],
    [7, 8]
];

let add = [];

for (let i = 0; i < 2; i++) {
    add[i] = [];
    for (let j = 0; j < 2; j++) {
        add[i][j] = A[i][j] + B[i][j];
    }
}

console.log("Matrix Addition:");
console.log(add);

let mul = [];

for (let i = 0; i < 2; i++) {
    mul[i] = [];
    for (let j = 0; j < 2; j++) {
        mul[i][j] = 0;

        for (let k = 0; k < 2; k++) {
            mul[i][j] += A[i][k] * B[k][j];
        }
    }
}

console.log("Matrix Multiplication:");
console.log(mul);
